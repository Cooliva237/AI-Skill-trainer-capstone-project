# Copy to .env.local, fill in the four values, then restart npm run dev.
# Choose local to test the camera without a Firebase project.
NEXT_PUBLIC_DATA_MODE=firebase
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_WEB_APP_ID
